# Image tag built by `docker compose build`.
KINEVYN_IMAGE=kinevyn:local

# Port on the host's 127.0.0.1 and inside the container. Keep both equal so the
# URLs returned by the server and MCP open in the host browser.
KINEVYN_PORT=4173

# Container memory limit. Rendering runs Chromium and FFmpeg; raise it for long
# or high-resolution exports.
KINEVYN_MEM_LIMIT=4g

# Set to 1 to disable analytics.
DO_NOT_TRACK=
